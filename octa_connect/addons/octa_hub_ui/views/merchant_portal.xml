<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="merchant_entry" name="Octa merchant sign-in entry">
        <html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Octa Connect · دخول التاجر</title><link rel="stylesheet" href="/octa_hub_ui/static/src/css/merchant_portal.css"/></head>
        <body class="octa-portal"><main class="entry"><div class="logo">OCTA<span>CONNECT</span></div><p class="eyebrow">كل قنواتك، في مكان واحد</p><h1>أهلًا بك في مساحة مطعمك</h1><p>تابع الطلبات والفروع وحالة الربط مع تطبيقات التوصيل.</p><a class="primary" href="/web/login?redirect=%2Focta%2Fportal">تسجيل الدخول إلى حسابك</a><p class="muted">الحسابات تنشئها أوكتاتيك. إذا لم تصلك الدعوة، تواصل مع مسؤول حسابك.</p></main></body></html>
    </template>
    <template id="merchant_portal" name="Octa merchant portal">
        <html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Octa Connect · بوابة التاجر</title><link rel="stylesheet" href="/octa_hub_ui/static/src/css/merchant_portal.css"/></head>
        <body class="octa-portal">
            <aside class="sidebar"><a class="logo" t-att-href="link('overview')">OCTA<span>CONNECT</span></a><p class="workspace-label">مساحة التاجر</p>
                <nav aria-label="القائمة الرئيسية">
                    <a t-att-class="'selected' if section == 'overview' else ''" t-att-href="link('overview')">نظرة عامة</a>
                    <a t-if="can_orders" t-att-class="'selected' if section == 'orders' else ''" t-att-href="link('orders')">الطلبات</a>
                    <a t-if="can_connections" t-att-class="'selected' if section == 'connections' else ''" t-att-href="link('connections')">تطبيقات التوصيل</a>
                    <a t-att-class="'selected' if section == 'account' else ''" t-att-href="link('account')">حسابي والفروع</a>
                </nav><div class="sidebar-note">ربط أوضح.<br/>متابعة أقرب.</div>
            </aside>
            <div class="workspace"><header><div><strong t-out="org_name"/><span class="muted"> / بوابة التاجر</span></div><div class="profile"><span t-out="user_name"/><a href="/web/session/logout?redirect=/octa/start">تسجيل الخروج</a></div></header>
            <main>
                <form t-if="len(organizations) &gt; 1" method="get" class="context-form"><label for="organization">حساب التاجر</label><select id="organization" name="organization"><option t-foreach="organizations" t-as="org" t-att-value="org['id']" t-att-selected="org['id'] == org_id" t-out="org['name']"/></select><button>عرض الحساب</button></form>
                <p class="eyebrow">OCTA CONNECT / MERCHANT WORKSPACE</p>
                <t t-if="section == 'overview'"><h1>كل شيء تحت نظرك</h1><p class="subtitle">ملخص الطلبات والربط ضمن الحساب والفروع المسموحة لك · جميع الفترات</p>
                    <div class="metrics"><article t-if="can_orders"><span>الطلبات المستلمة</span><strong t-out="order_count"/><small>محفوظة في أوكتا</small></article><article t-if="can_orders"><span>تأكد تسجيلها</span><strong t-out="confirmed_count"/><small>تأكيد النقل، وليس تسليم العميل</small></article><article t-if="can_orders"><span>تحتاج متابعة</span><strong t-out="attention_count"/><small>نتيجة مجهولة أو تدخل مطلوب</small></article><article t-if="can_connections"><span>اتصالات التطبيقات</span><strong t-out="connection_count"/><small>عدد إعدادات الربط المسجلة</small></article></div>
                    <section class="panel"><h2>ابدأ من هنا</h2><p>راجع طلباتك وتحقق من جاهزية كل تطبيق. عرض اتصال هنا لا يعني اكتمال اعتماده للتشغيل.</p><div class="quick-links"><a t-if="can_orders" class="primary" t-att-href="link('orders')">متابعة الطلبات</a><a t-if="can_connections" class="secondary" t-att-href="link('connections')">مراجعة التطبيقات</a></div></section>
                </t>
                <t t-if="section == 'orders'"><h1>الطلبات</h1><p class="subtitle">حالة النقل منفصلة عن حالة تجهيز الطلب.</p><t t-if="can_orders"><form method="get" class="search panel"><input type="hidden" name="organization" t-att-value="org_id"/><label for="q">رقم الطلب الخارجي</label><input id="q" name="q" t-att-value="q" maxlength="160" placeholder="ابحث بالرقم كاملًا"/><button class="primary">بحث</button><a t-att-href="link('orders')">مسح</a></form><div t-if="orders" class="panel table-wrap"><table><thead><tr><th>رقم الطلب</th><th>الفرع</th><th>النقل</th><th>الطلب</th><th>وقت الاستلام (UTC)</th></tr></thead><tbody><tr t-foreach="orders" t-as="order"><td class="identifier" t-out="order['external_order_id']"/><td t-out="order['branch_id'][1]"/><td><span class="badge" t-out="transport_labels[order['transport_state']]"/></td><td t-out="commercial_labels[order['commercial_state']]"/><td class="identifier" t-out="order['create_date']"/></tr></tbody></table></div><section t-else="" class="panel empty"><h2>لا توجد طلبات مطابقة</h2><p>ستظهر هنا الطلبات الواردة ضمن صلاحيات حسابك.</p></section></t><section t-else="" class="panel">دورك الحالي لا يسمح بعرض الطلبات.</section></t>
                <t t-if="section == 'connections'"><h1>تطبيقات التوصيل</h1><p class="subtitle">حالة كل اتصال مسجل لحسابك. لا نعرض مفاتيح الربط أو الأسرار.</p><t t-if="can_connections"><div t-if="connections" class="connection-grid"><article class="panel" t-foreach="connections" t-as="connection"><div class="app-icon" t-out="connection['connector_code'][:1].upper()"/><h2 t-out="connection['connector_code']"/><p>اتصال #<t t-out="connection['id']"/></p><ul class="status-list"><li>الاتصال التقني <span t-out="'متصل' if connection['technically_connected'] else 'غير مؤكد'"/></li><li>اعتماد الإنتاج <span t-out="'معتمد' if connection['production_approved'] else 'بانتظار الاعتماد'"/></li><li>جاهزية الفرع <span t-out="'جاهز' if connection['branch_ready'] else 'غير جاهز'"/></li></ul></article></div><section t-else="" class="panel empty"><h2>لم يُسجّل أي اتصال بعد</h2><p>بعد تهيئة ربط التطبيقات، ستظهر حالة كل اتصال هنا.</p></section></t><section t-else="" class="panel">دورك الحالي لا يسمح بعرض اتصالات التطبيقات.</section></t>
                <t t-if="section == 'account'"><h1>حسابي والفروع</h1><p class="subtitle">الحساب والصلاحيات تديرها أوكتاتيك.</p><section class="panel"><h2 t-out="org_name"/><dl><dt>المستخدم</dt><dd t-out="user_name"/><dt>البريد / اسم الدخول</dt><dd class="identifier" t-out="user_email"/><dt>دورك</dt><dd t-out="role_name"/><dt>حالة الحساب</dt><dd t-out="org_state"/></dl></section><section class="panel" t-if="can_branches"><h2>الفروع المسموحة (<t t-out="branch_count"/>)</h2><p t-if="not branches">لا توجد فروع ظاهرة لحسابك.</p><ul class="branch-list"><li t-foreach="branches" t-as="branch"><strong t-out="branch['name']"/><span t-out="branch['external_pos_system'] or 'نظام نقطة البيع غير محدد'"/><small t-out="branch['timezone']"/></li></ul><p t-if="branch_count &gt; 100" class="muted">يظهر أول 100 فرع فقط في هذه النسخة.</p></section></t>
                <nav t-if="section in ['orders', 'connections'] and (page &gt; 1 or has_next)" class="pagination" aria-label="صفحات النتائج"><a t-if="page &gt; 1" t-att-href="link(section, page=page-1, q=q)">السابق</a><span>صفحة <t t-out="page"/></span><a t-if="has_next" t-att-href="link(section, page=page+1, q=q)">التالي</a></nav>
            </main><footer>Octa Connect · مساحة آمنة لإدارة الربط</footer></div>
        </body></html>
    </template>
</odoo>
